<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/formatting_toolbar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/formatting_toolbar_height"
    android:background="?android:windowBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/formatting_toolbar_padding_horizontal"
    android:paddingEnd="@dimen/formatting_toolbar_padding_horizontal"
    android:visibility="gone">

    <ImageView
        android:id="@+id/format_bold"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="@dimen/formatting_button_padding"
        android:src="@drawable/ic_format_bold"
        android:tint="@color/formatting_button_tint"
        android:contentDescription="@string/format_bold"
        android:background="@drawable/bg_formatting_button"
        android:scaleType="centerInside" />

    <ImageView
        android:id="@+id/format_italic"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="@dimen/formatting_button_padding"
        android:src="@drawable/ic_format_italic"
        android:tint="@color/formatting_button_tint"
        android:contentDescription="@string/format_italic"
        android:background="@drawable/bg_formatting_button"
        android:scaleType="centerInside" />

    <ImageView
        android:id="@+id/format_strikethrough"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="@dimen/formatting_button_padding"
        android:src="@drawable/ic_format_strikethrough"
        android:tint="@color/formatting_button_tint"
        android:contentDescription="@string/format_strikethrough"
        android:background="@drawable/bg_formatting_button"
        android:scaleType="centerInside" />

    <ImageView
        android:id="@+id/format_underline"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="@dimen/formatting_button_padding"
        android:src="@drawable/ic_format_underline"
        android:tint="@color/formatting_button_tint"
        android:contentDescription="@string/format_underline"
        android:background="@drawable/bg_formatting_button"
        android:scaleType="centerInside" />

    <View
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="?android:textColorSecondary" />

    <ImageView
        android:id="@+id/format_h1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="@dimen/formatting_button_padding"
        android:src="@drawable/ic_format_h1"
        android:tint="@color/formatting_button_tint"
        android:contentDescription="@string/heading_h1"
        android:background="@drawable/bg_formatting_button"
        android:scaleType="centerInside" />

    <ImageView
        android:id="@+id/format_h2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="@dimen/formatting_button_padding"
        android:src="@drawable/ic_format_h2"
        android:tint="@color/formatting_button_tint"
        android:contentDescription="@string/heading_h2"
        android:background="@drawable/bg_formatting_button"
        android:scaleType="centerInside" />

    <ImageView
        android:id="@+id/format_paragraph"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="@dimen/formatting_button_padding"
        android:src="@drawable/ic_format_paragraph"
        android:tint="@color/formatting_button_tint"
        android:contentDescription="@string/paragraph_normal"
        android:background="@drawable/bg_formatting_button"
        android:scaleType="centerInside" />

    <View
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="?android:textColorSecondary" />

    <ImageView
        android:id="@+id/format_checklist"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="@dimen/formatting_button_padding"
        android:src="@drawable/ic_checklist"
        android:tint="@color/formatting_button_tint"
        android:contentDescription="@string/format_checklist"
        android:background="@drawable/bg_formatting_button"
        android:scaleType="centerInside" />

</LinearLayout>
