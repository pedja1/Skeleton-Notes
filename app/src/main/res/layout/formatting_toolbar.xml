<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/formatting_toolbar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/formatting_toolbar_height"
    android:scrollbars="none"
    android:background="?android:windowBackground"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/toolbar_padding_horizontal"
        android:paddingEnd="@dimen/toolbar_padding_horizontal">

        <ImageView
            android:id="@+id/format_bold"
            android:layout_width="@dimen/formatting_button_touch_target"
            android:layout_height="match_parent"
            android:padding="@dimen/formatting_button_padding"
            android:src="@drawable/ic_format_bold"
            android:contentDescription="@string/format_bold"
            android:background="?android:selectableItemBackgroundBorderless"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/format_italic"
            android:layout_width="@dimen/formatting_button_touch_target"
            android:layout_height="match_parent"
            android:padding="@dimen/formatting_button_padding"
            android:src="@drawable/ic_format_italic"
            android:contentDescription="@string/format_italic"
            android:background="?android:selectableItemBackgroundBorderless"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/format_font_size"
            android:layout_width="@dimen/formatting_button_touch_target"
            android:layout_height="match_parent"
            android:padding="@dimen/formatting_button_padding"
            android:src="@drawable/ic_format_font_size"
            android:contentDescription="@string/format_font_size"
            android:background="?android:selectableItemBackgroundBorderless"
            android:scaleType="centerInside" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="?android:textColorSecondary" />

        <ImageView
            android:id="@+id/format_attach_file"
            android:layout_width="@dimen/formatting_button_touch_target"
            android:layout_height="match_parent"
            android:padding="@dimen/formatting_button_padding"
            android:src="@drawable/ic_attach_file"
            android:contentDescription="@string/format_attach_file"
            android:background="?android:selectableItemBackgroundBorderless"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/format_attach_image"
            android:layout_width="@dimen/formatting_button_touch_target"
            android:layout_height="match_parent"
            android:padding="@dimen/formatting_button_padding"
            android:src="@drawable/ic_attach_image"
            android:contentDescription="@string/format_attach_image"
            android:background="?android:selectableItemBackgroundBorderless"
            android:scaleType="centerInside" />

    </LinearLayout>

</HorizontalScrollView>
