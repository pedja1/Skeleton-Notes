<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/toolbar_height"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/toolbar_padding_horizontal"
    android:paddingEnd="@dimen/toolbar_padding_horizontal">

    <ImageView
        android:id="@+id/toolbar_back"
        android:layout_width="@dimen/toolbar_icon_size"
        android:layout_height="@dimen/toolbar_icon_size"
        android:layout_marginEnd="@dimen/toolbar_icon_margin"
        android:background="?android:selectableItemBackgroundBorderless"
        android:contentDescription="@string/toolbar_back"
        android:src="@drawable/ic_arrow_back"
        android:tint="?android:textColorPrimary"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/toolbar_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/toolbar_icon_margin"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lines="1"
        android:text="@string/app_name"
        android:textColor="?android:textColorPrimary"
        android:textSize="@dimen/toolbar_title_size"
        android:textStyle="bold"
        tools:text="Very long title asda dasd asd ad adad" />

    <ImageView
        android:id="@+id/toolbar_add_note"
        android:layout_width="@dimen/toolbar_icon_size"
        android:layout_height="@dimen/toolbar_icon_size"
        android:layout_marginEnd="@dimen/toolbar_icon_margin"
        android:background="?android:selectableItemBackgroundBorderless"
        android:contentDescription="@string/toolbar_add_note"
        android:src="@drawable/ic_add_note"
        android:tint="?android:textColorPrimary" />

    <ImageView
        android:id="@+id/toolbar_settings"
        android:layout_width="@dimen/toolbar_icon_size"
        android:layout_height="@dimen/toolbar_icon_size"
        android:background="?android:selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings_title"
        android:src="@drawable/ic_settings"
        android:tint="?android:textColorPrimary" />

</LinearLayout>
